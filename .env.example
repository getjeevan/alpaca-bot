# ─── Alpaca credentials (required) ───
# Get these from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true

# ─── Strategy parameters ───
INITIAL_CAPITAL=1000
ALLOCATION_PER_STOCK=100
TAKE_PROFIT=0.05
STOP_LOSS=-0.025
DD_CIRCUIT=-0.03
DD_KILL=-0.05
PDT_LIMIT=3
ENTRY_BAND_LOW=-0.015
ENTRY_BAND_HIGH=0.01

# ─── Universe ───
WATCHLIST=IONQ,RGTI,BBAI,SOUN,OPEN,CHPT,PLUG,LAZR,RKLB,PRSO

# ─── Runtime ───
INTERVAL_SECONDS=60
RUN_ONCE=false
DRY_RUN=false

# ─── Notifications (all optional — leave blank to disable) ───
# Slack: create a webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Email via SMTP (Gmail: use an App Password, not your regular password)
#   Get one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
